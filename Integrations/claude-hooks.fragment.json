{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "UserPromptExpansion": [
      { "matcher": "^nc$", "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "Notification": [
      { "matcher": "agent_needs_input|agent_completed", "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "SubagentStart": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "SubagentStop": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "__BRIDGE__", "timeout": 2 }] }
    ]
  }
}
